# Required for docker compose — generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Postgres (compose `db` service) — required
POSTGRES_PASSWORD=change-me-too

# Direct DB connection for local dev without compose (pnpm dev:api):
# KREATIX_DATABASE_URL=postgres://postgres:postgres@localhost:5432/kreatix

# Host port the app publishes on (useful when 80/443 are taken by another proxy)
# APP_PORT=3017

# Optional: run with `docker compose --profile tls up -d` and set a domain for automatic HTTPS
# SITE_ADDRESS=suite.example.com

# Kreatix AI (server-side LLM proxy — key never reaches the browser).
# Any OpenAI-compatible /chat/completions endpoint works.
# KREATIX_AI_KEY=sk-...
# KREATIX_AI_BASE_URL=https://api.openai.com/v1
# KREATIX_AI_MODEL=gpt-4o-mini
# Optional per-mode overrides — e.g. a stronger model for edits:
# KREATIX_AI_MODEL_EDIT=gpt-4o
# KREATIX_AI_MODEL_PLAN=gpt-4o
# KREATIX_AI_MODEL_COMPLETE=gpt-4o-mini   # ghost-text completion — use a cheap/fast model
# Reasoning models (Groq gpt-oss, OpenAI o-series) accept an effort hint —
# "low" cuts cost + latency while keeping ops quality; leave unset to omit.
# KREATIX_AI_REASONING_EFFORT=low
#
# Plan-tier models — business workspaces can ride a stronger model:
# KREATIX_AI_MODEL_BUSINESS=llama-3.3-70b-versatile
# (optional per-mode tier overrides: KREATIX_AI_MODEL_EDIT_BUSINESS=…, etc.)
#
# Provider failover — on 429/5xx the request retries once on the primary, then
# falls through to a second OpenAI-compatible provider (degrade ≠ downtime):
# KREATIX_AI_FALLBACK_KEY=
# KREATIX_AI_FALLBACK_BASE_URL=https://api.openai.com/v1
# KREATIX_AI_FALLBACK_MODEL=gpt-4o-mini   # required if model names differ
#
# Semantic retrieval for workspace Q&A (pgvector + embeddings — dormant
# without these). Note: embeddings are stored as plaintext vectors.
# KREATIX_AI_EMBED_KEY=
# KREATIX_AI_EMBED_BASE_URL=https://api.openai.com/v1
# KREATIX_AI_EMBED_MODEL=text-embedding-3-small
#
# Cost controls — AI is a paid-plan feature:
# KREATIX_AI_TRIAL_REQUESTS=50          # lifetime AI requests for trialing workspaces
# KREATIX_AI_ORG_TOKENS_BASE=3000000    # monthly token budget per paid workspace
# KREATIX_AI_ORG_TOKENS_PER_SEAT=1000000  # + this per extra seat
# KREATIX_AI_ORG_TOKENS_BUSINESS_BASE=12000000    # business-tier workspaces
# KREATIX_AI_ORG_TOKENS_BUSINESS_PER_SEAT=4000000 # + this per extra business seat
# All requests ride KREATIX_AI_KEY — the plan tier (standard|business) sets the
# allowance and per-user limits. Business price = standard × billing multiplier.
# KREATIX_AI_USER_DAILY=300             # per-user requests/day (standard)
# KREATIX_AI_USER_DAILY_BUSINESS=1000   # per-user requests/day (business)
# KREATIX_AI_USER_PER_MIN=20            # per-user burst (standard)
# KREATIX_AI_USER_PER_MIN_BUSINESS=40   # per-user burst (business)
# KREATIX_AI_MONTHLY_BUDGET_USD=200     # platform circuit-breaker (all workspaces)
# KREATIX_AI_PRICE_IN_PER_MTOK=0.15     # USD per 1M prompt tokens (est. cost basis)
# KREATIX_AI_PRICE_OUT_PER_MTOK=0.60    # USD per 1M completion tokens

# --- Security / enterprise ---
# Encrypt all blob storage at rest (AES-256-GCM). 64-hex key or any passphrase.
# Without it, stored blobs remain plaintext on disk.
# KREATIX_DATA_KEY=openssl rand -hex 32

# OIDC single sign-on (any compliant provider: Google, Entra ID, Okta, Keycloak…)
# KREATIX_OIDC_ISSUER=https://accounts.google.com
# KREATIX_OIDC_CLIENT_ID=
# KREATIX_OIDC_CLIENT_SECRET=
# KREATIX_OIDC_REDIRECT=            # optional; default KREATIX_PUBLIC_URL (or Host) + /api/auth/sso/callback
# KREATIX_OIDC_SCOPE="openid email profile"
# Require the IdP's email_verified claim (default: strict). Set to 0 ONLY if
# your IdP provably does not emit the claim.
# KREATIX_OIDC_REQUIRE_VERIFIED_EMAIL=1

# CORS — extra origins allowed to make credentialed requests (comma-separated).
# KREATIX_PUBLIC_URL and localhost dev origins are always allowed.
# KREATIX_CORS_ORIGINS=https://app.example.com,https://staging.example.com

# SAML 2.0 SSO (Okta/Entra/ADFS/Ping). SP metadata at /api/auth/saml/metadata
# KREATIX_SAML_ENTRY_POINT=https://idp.example.com/sso
# KREATIX_SAML_ISSUER=https://suite.example.com          # our SP entityID
# KREATIX_SAML_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"  # IdP signing cert
# KREATIX_SAML_CALLBACK=                                  # optional; default <origin>/api/auth/saml/callback
# KREATIX_SAML_AUDIENCE=                                  # optional; defaults to issuer
# KREATIX_SAML_WANT_SIGNED=true                           # require signed response+assertion (default true)

# External malware scanner — invoked per upload as `<cmd> <tmpfile>`;
# non-zero exit rejects the upload. Example: clamscan --no-summary
# KREATIX_SCAN_CMD=

# --- Billing / subscriptions ---
# Platform superadmin — seeded at boot if both are set; password lives only
# here (never in source). Change after first sign-in by editing the DB user.
# KREATIX_SUPERADMIN_EMAIL=admin@kreatixtech.com
# KREATIX_SUPERADMIN_PASSWORD=set-a-strong-password
# Card payments via Paystack (https://paystack.com). Without it, checkout
# falls back to manual bank-transfer confirmation by the superadmin.
# KREATIX_PAYSTACK_SECRET=sk_live_...
# Public origin for the Paystack redirect + links in emails.
# KREATIX_PUBLIC_URL=https://suites.example.com

# --- Transactional email via Brevo (https://brevo.com) ---
# Without a key, emails are silently skipped — nothing breaks.
# KREATIX_BREVO_API_KEY=xkeysib-...
# KREATIX_MAIL_FROM=hello@example.com        # must be a verified Brevo sender
# KREATIX_MAIL_FROM_NAME=Kreatix Suites

# Desktop offline entitlement signing (separate from JWT_SECRET — this key is
# embedded in the desktop build to verify offline grace). Generate: openssl rand -hex 32
# KREATIX_ENTITLEMENT_SECRET=
