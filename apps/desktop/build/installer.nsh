; Uninstall cleanup for the per-app shortcuts and file links the app creates
; after first sign-in (see configureApps in src/main.ts).

!macro customUnInstall
  Delete "$SMPROGRAMS\Writer.lnk"
  Delete "$SMPROGRAMS\Sheets.lnk"
  Delete "$SMPROGRAMS\Present.lnk"
  Delete "$SMPROGRAMS\Board.lnk"
  Delete "$SMPROGRAMS\PDF.lnk"
  Delete "$SMPROGRAMS\Kreatavi.lnk"
  Delete "$SMPROGRAMS\Meet.lnk"
  Delete "$SMPROGRAMS\Chat.lnk"
  Delete "$SMPROGRAMS\Calendar.lnk"
  Delete "$SMPROGRAMS\Tasks.lnk"
  Delete "$SMPROGRAMS\Notes.lnk"
  Delete "$SMPROGRAMS\Forms.lnk"
  Delete "$SMPROGRAMS\Sites.lnk"
  Delete "$DESKTOP\Writer.lnk"
  Delete "$DESKTOP\Sheets.lnk"
  Delete "$DESKTOP\Present.lnk"
  Delete "$DESKTOP\Board.lnk"
  Delete "$DESKTOP\PDF.lnk"
  Delete "$DESKTOP\Kreatavi.lnk"
  Delete "$DESKTOP\Meet.lnk"
  Delete "$DESKTOP\Chat.lnk"
  Delete "$DESKTOP\Calendar.lnk"
  Delete "$DESKTOP\Tasks.lnk"
  Delete "$DESKTOP\Notes.lnk"
  Delete "$DESKTOP\Forms.lnk"
  Delete "$DESKTOP\Sites.lnk"
  DeleteRegKey HKCU "Software\Classes\KreatixSuites.writer"
  DeleteRegKey HKCU "Software\Classes\KreatixSuites.sheets"
  DeleteRegKey HKCU "Software\Classes\KreatixSuites.present"
  DeleteRegKey HKCU "Software\Classes\KreatixSuites.board"
  DeleteRegKey HKCU "Software\Classes\KreatixSuites.pdf"
  DeleteRegKey HKCU "Software\Classes\KreatixSuites.mail"
  DeleteRegKey HKCU "Software\Classes\KreatixSuites.meet"
  DeleteRegKey HKCU "Software\Classes\KreatixSuites.chat"
  DeleteRegKey HKCU "Software\Classes\KreatixSuites.calendar"
  DeleteRegKey HKCU "Software\Classes\KreatixSuites.tasks"
  DeleteRegKey HKCU "Software\Classes\KreatixSuites.notes"
  DeleteRegKey HKCU "Software\Classes\KreatixSuites.forms"
  DeleteRegKey HKCU "Software\Classes\KreatixSuites.sites"
!macroend
