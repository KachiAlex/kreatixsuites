{
  "name": "@kreatix/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=cjs --target=node20 --external:better-sqlite3 --external:pg --external:pg-native --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:mfa": "tsx test-mfa.mts"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "10.1.4",
    "@fastify/websocket": "11.3.1",
    "@kreatix/shared": "workspace:*",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1",
    "jose": "^6.1.0",
    "lib0": "0.2.117",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.23.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.32",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "24.13.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2"
  }
}
