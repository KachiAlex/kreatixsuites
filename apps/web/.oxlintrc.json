{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    // Advisory-only React Compiler lints — this codebase isn't compiled by the
    // compiler; the flagged patterns (mount fetches, reset-on-prop effects,
    // component+helper colocation) are intentional and correct without it.
    "react/only-export-components": "off",
    "react/set-state-in-effect": "off",
    "react/preserve-manual-memoization": "off"
  }
}
